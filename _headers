/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://checkout.razorpay.com; style-src 'self'; font-src 'self'; img-src 'self' blob: data: https://upload.wikimedia.org https://*.razorpay.com; connect-src 'self' https://*.supabase.co https://upload.wikimedia.org https://api.open-meteo.com https://customer-api.open-meteo.com https://api.razorpay.com https://lumberjack.razorpay.com; frame-src https://api.razorpay.com https://checkout.razorpay.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; upgrade-insecure-requests; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), usb=(), serial=(), bluetooth=(), payment=(self "https://checkout.razorpay.com"), browsing-topics=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Resource-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none

/sw.js
  Cache-Control: no-cache
/config.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/app.js
  Cache-Control: no-cache
/app.css
  Cache-Control: no-cache
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/img/*
  Cache-Control: public, max-age=604800
/contact.html
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Cache-Control: no-store
